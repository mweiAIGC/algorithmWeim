package class18;

public class Code03_MinBoat {
    /**
     * 给定一个数组arr，长度为N且每个值都是整数，代表N个人的体重。在给定一个整数limit，代表一艘船的载重。
     * 以下是坐船规则：
     * 1)每艘船最多只能坐两人；
     * 2)乘客的体重和不能超过limit；
     * 返回如果同时让这N个人过河最少需要几条船。
     * 算法分析：
     * ①通过arr[i] <= limit/2 将数组分为左右两边；计算左半界和右半界能两人一条船的为solved，
     * 其可通过计算左边不能和右边两人一条船的unSolved得到，即solved = leftAll-unSolved
     */
    public static int minBoat(int[] arr, int limit) {
        if (arr == null || arr.length == 0) {
            return 0;
        }
        int N = arr.length;
        if(arr[N-1] > limit) return -1;
        int index = -1;
        for (int i = N - 1; i >= 0; i--) {
            if (arr[i] <= (limit / 2)) {
                index = i;
                break;
            }
        }
        if (index == -1) return N;
        int L = index;
        int R = index + 1;
        int notSolved = 0;
        while (L >= 0) {
            int solved = 0;
            while (R < arr.length && arr[R] + arr[L] <= limit) {
                R++;
                solved++;
            }
            if (solved == 0) {
                notSolved++;
                L--;
            } else {
                L -= solved;
            }

        }
        int leftAll = index + 1;
        int used = leftAll - notSolved;
        int rightNotSolved = N - leftAll - used;

        return used + rightNotSolved + ((notSolved+1) >> 1);

    }
    public static void main(String[] args) {
        int[] arr = { 1, 2, 2, 2, 2, 3, 3, 3, 3, 3, 4, 4, 4, 4, 5 };
        int weight = 6;
        System.out.println(minBoat(arr, weight));
    }
}
