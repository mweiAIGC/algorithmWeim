package class18;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.Comparator;
import java.util.List;
import java.util.Map.Entry;
import java.util.TreeMap;

public class Code01_BuildingOutline {
    /**
     * 给定一个N×3的矩阵matrix，对于每一个长度为3的小数组arr，都表示一个大楼的三个数据。arr[0]表示大楼的左边界，
     * arr[1]表示大楼的右边界，arr[2]表示大楼的高度(一定大于0).每座大楼的地基都在X轴上，大楼之间可能会有重叠，请
     * 返回整体的轮廓线数组。
     * eg:matrix={{2,5,6},{1,7,4},{4,6,7},{3,6,5},{10,13,2},{9,11,3},{12,14,4},{10,12,5}}
     * return:{{1,2,4},{2,4,6},{4,6,7},{6,7,4},{9,10,3},{10,12,5},{12,14,4}}
     * 算法思路：
     * eg:{2,5,6}:{2:+6,5:-6},{1,7,4}:{1:+4,7:-4}...
     * 2.先加后减，防止遇到纸片大楼，eg:{8,8,1}
     */

    public static class opt {
        public int x;
        public boolean isAdd; // 开始位置是add，结束位置是minus
        public int h;

        public opt(int x, boolean isAdd, int h) {
            this.x = x;
            this.isAdd = isAdd;
            this.h = h;
        }
    }

    public class optComparator implements Comparator<opt> {
        @Override
        public int compare(opt o1, opt o2) {
            if (o1.x != o2.x) {
                return o1.x - o2.x;
            }
            if (o1.isAdd != o2.isAdd) {
                return o1.isAdd ? -1 : 1;
            }
            return 0;
        }

    }

    public List<List<Integer>> buildingOutline(int[][] buildings) {
        int N = buildings.length;
        opt[] opts = new opt[N << 1];
        for (int i = 0; i < N; i++) {
            opts[2 * i] = new opt(buildings[i][0], true, buildings[i][2]);
            opts[2 * i + 1] = new opt(buildings[i][1], false, buildings[i][2]);
        }
        Arrays.sort(opts, new optComparator());
        TreeMap<Integer, Integer> HeightSizeMap = new TreeMap<>();
        TreeMap<Integer, Integer> XHeightMap = new TreeMap<>();
        for (opt opt : opts) {
            if (opt.isAdd) {
                if (HeightSizeMap.containsKey(opt.h)) {
                    HeightSizeMap.put(opt.h, HeightSizeMap.get(opt.h) + 1);
                } else {
                    HeightSizeMap.put(opt.h, 1);
                }

            } else {
                if (HeightSizeMap.get(opt.h) == 1) {
                    HeightSizeMap.remove(opt.h);
                } else {
                    HeightSizeMap.put(opt.h, HeightSizeMap.get(opt.h) - 1);
                }
            }
            if (HeightSizeMap.isEmpty()) { // 如果HeightSizeMap为空，说明x的高度为0
                XHeightMap.put(opt.x, 0);
            } else {
                XHeightMap.put(opt.x, HeightSizeMap.lastKey());
            }
        }
        int preHeight = 0;
        int start = 0;
        List<List<Integer>> res = new ArrayList<>();
        for(Entry<Integer, Integer> entry: XHeightMap.entrySet()){
            if(preHeight != 0){
                res.add(new ArrayList<>(Arrays.asList(start, preHeight,entry.getValue())));
            }
            start = entry.getKey();
            preHeight = entry.getValue();
        }
        return res;
    }

}
