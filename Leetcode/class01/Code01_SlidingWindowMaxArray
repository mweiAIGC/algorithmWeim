package class01;

import java.util.LinkedList;

/**
 * 假设一个固定大小为W的窗口，依次划过arr，返回每一次滑出状况的最大值
 * eg,arr=[4,3,5,4,3,3,6,7],W = 3
 * return:[5,5,5,4,6,7]
 */
public class Code01_SlidingWindowMaxArray {
    public static int[] getMaxSlidingWindow(int[] nums, int w) {
        if(nums == null|| w < 1||nums.length < 2) return null;
        int[] res = new int[nums.length - w + 1];
        LinkedList<Integer> list = new LinkedList<Integer>();
        int index = 0;
        for(int i = 0; i < nums.length;i++){
            // 定义尾出队
            while(!list.isEmpty() && nums[list.peekLast()] <= nums[i]){
                list.pollLast();
            }
            list.add(i);
            // 定义头出队
            if(list.peekLast()-w==list.peekFirst()){
                list.pollFirst();
            }
            if(i>=w-1){
                res[index++] = nums[list.peekFirst()];
            }



        }
        return res;
    }
}
