package class10;

import java.util.Comparator;
import java.util.PriorityQueue;
public class Code01_TopKSumCrossTwoArrayList {
    // 给定两个有序组arr1和arr2，再给定一个正数K，求两个数累加和最大的前K个，两个数必须分别来自arr1和arr2
    /**
     * 算法思路：（通过大根堆实现）
     * 1.定义大根堆节点(index1,index2,sum)
     * 2.定义比较器，形成大根堆
     * 3.定义boolean类型的set数组，验证数组对应位置是否进入过大根堆
     * 4.由于是有序组，所以从arr1和arr2的最后一个位置求sum
     */
    public static class Node{
        public int index1;
        public int index2;
        public int sum;
        public Node(int index1, int index2, int sum) {
            this.index1 = index1;
            this.index2 = index2;
            this.sum = sum;
        }
    }
    public class arrComparator implements Comparator<Node> {
        @Override
        public int compare(Node n1, Node n2) {
            return n2.sum - n1.sum;
        }
    }
    public int[] topKSum(int[] arr1, int[] arr2, int topK) {
        if(arr1 == null||arr2 == null || topK <1) return null;
        topK = Math.min(topK,arr1.length*arr2.length);
        PriorityQueue<Node> pq = new PriorityQueue<>(new arrComparator());

        int[] res = new int[topK];
        int resIndex = 0;
        pq.add(new Node(0,0,arr1[0]+arr2[0]));
        boolean[][] set = new boolean[arr1.length][arr2.length];
        set[arr1.length-1][arr2.length-1] = true;
        while(!pq.isEmpty() && resIndex < topK){
            Node node = pq.poll();
            res[resIndex++] = node.sum;
            if(node.index1-1!= -1 && !set[node.index1-1][node.index2]){
                pq.add(new Node(node.index1-1, node.index2, arr1[node.index1-1]+arr2[node.index2]));
                set[node.index1-1][node.index2] = true;
            }
            if(node.index2-1!=-1 && !set[node.index2][node.index1]){
                pq.add(new Node(node.index1, node.index2-1,arr1[node.index1] + arr2[node.index2-1]));
                set[node.index1][node.index2-1] = true;
            }
        }

        return res;
    }
}
