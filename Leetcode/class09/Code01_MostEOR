package class09;
import java.util.HashMap;
public class Code01_MostEOR {
    public static int mostEor(int[] arr){
        int[] dp = new int[arr.length]; // 表示异或和的数量
        HashMap<Integer, Integer> map = new HashMap<>();
        int sum = 0;
        map.put(0,-1);
        for(int i = 0;i < arr.length;i++){
            sum^=arr[i];
            if(map.containsKey(sum)){
                int pre = map.get(sum);
                dp[i] = pre == -1 ? 1 : dp[pre]+1; //此时表示如果(pre+1,i)的异或和为0，那么dp[i] = dp[pre]+1；其中pre==-1表示(0,i)是一块
            }
            if(i>0){
                dp[i] = Math.max(dp[i],dp[i-1]); // dp[i-1] 表示 dp[i]的位置异或和不为0，此时dp[i]==dp[i-1]
            }
            map.put(sum,i);
        }
        return dp[arr.length-1];
    }
}
