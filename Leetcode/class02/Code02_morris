package class02;

public class Code02_morris {
    public static class Node {
        public int val;
        public Node left;
        public Node right;

        public Node(int val) {
            this.val = val;
        }
    }

    public static void morris(Node root) {
        if (root == null) return;
        Node cur = root;
        while (cur != null) {
            Node MostRightInLeft = cur.left;
            if (MostRightInLeft != null) {
                while (MostRightInLeft.right != null && MostRightInLeft.right != cur) {
                    MostRightInLeft = MostRightInLeft.right;
                }
                if (MostRightInLeft.right == null) {
                    MostRightInLeft.right = cur;
                    cur = cur.left;
                    continue;
                } else {
                    MostRightInLeft.right = null;
                }
            }
            cur = cur.right;
        }
    }

