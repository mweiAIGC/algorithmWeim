    public static void printPost(Node head){
        Node cur = head.left;
        reverseTree(cur);
        while (cur != null) {
            System.out.print(cur.val + " ");
            cur = cur.right;
        }
        reverseTree(cur);
    }
    public static void reverseTree(Node cur){
        Node pre = null;
        while (cur != null) {
            Node next = cur.right;
            cur.right = pre;
            pre = cur;
            cur = next;
        }
    }
