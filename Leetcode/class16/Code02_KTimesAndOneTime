package class16;

public class Code02_KTimesAndOneTime {
    /**
     * 给定一个int类型的数组arr，已知除了一种数只出现1此之外，剩下所有的数都出现k次，如何使用O(1)
     * 的额外空间，找到这个数。
     * 算法思路：
     * 出现k次就用k进制，将获得的结果累加个一个32位的数组上，比如14，k=3，转为3进制结果为1,1,2,
     * 假设14出现3次那么将最后的结果mode(3)，那么结果就是0。最终剩余的数，就是出现1次的数。
     */
    public static int OneNum(int[] arr, int k) {
        int[] e0 = new int[32];
        for (int i = 0; i < arr.length; i++) {
            setExclusiveOr(arr[i], k, e0);
        }
        int res = getNumFromKSysNum(e0, k);
        return res;
    }

    private static int getNumFromKSysNum(int[] e0, int k) {
        int res = 0;
        for(int num:e0){
            res = res*k + num;
        }
        return res;
    }

    private static void setExclusiveOr(int value, int k, int[] e0) {
        int[] curKSysNum = getKSysNumFromNum(value, k);
        for(int i = 0; i < e0.length; i++) {
            e0[i] += curKSysNum[i] % k;
        }
    }

    private static int[] getKSysNumFromNum(int value, int k) {
        int[] e0 = new int[32];
        int index = 0;
        while(value != 0){
            e0[index++] = value % k;
            value /= k;
        }
        return e0;
    }


}
