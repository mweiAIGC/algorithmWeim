package class17;

public class Code01_FindKthMinNumber {
    /**
     * 给定两个整数数组A和B
     * A是长度为m，B是长度为n,两个数组的元素都从小到大都排序好了
     * 希望从A和B数组中，找出最大的第k个数字。
     * 算法步骤：
     * 1.求上中位数
     */
    public static int getUpMedian(int[] A, int s1, int e1, int[] B, int s2, int e2) {
        int mid1 = 0;
        int mid2 = 0;
        while (s1 < e1) {
            mid1 = s1 + (e1 - s1) >> 1;
            mid2 = s2 + (e2 - s2) >> 1;
            if (((e1 - s1 + 1) & 1) == 1) { //奇数长度
                if (A[mid1] == B[mid2]) {
                    return A[mid1];
                }
                if (A[mid1] > B[mid2]) {
                    if (B[mid2] >= A[mid1 - 1]) {
                        return B[mid2];
                    } else {
                        e1 = mid1 - 1;
                        s2 = mid2 + 1;
                    }
                } else if (A[mid1] < B[mid2]) {
                    if (A[mid1] >= B[mid2]) {
                        return A[mid1];
                    } else {
                        s1 = mid1 + 1;
                        e2 = mid2 - 1;
                    }
                }

            } else {
                if (A[mid1] > B[mid2]) {
                    e1 = mid1;
                    s2 = mid2 + 1;
                } else {
                    s1 = mid1 + 1;
                    e2 = mid2;
                }
            }
        }
        return Math.min(A[s1], B[s2]);
    }

    public static int process(int[] arr1, int[] arr2, int Kth) {
        if (arr1 == null || arr2 == null) return -1;
        if (Kth < 1 || Kth > (arr2.length + arr1.length)) return -1;
        int[] longArr = arr1.length > arr2.length ? arr1 : arr2;
        int[] shortArr = longArr == arr1 ? arr2 : arr1;
        int s = shortArr.length;
        int l = longArr.length;
        if (Kth <= s) {
            return getUpMedian(shortArr, 0, Kth-1, longArr, 0, Kth-1);
        }
        if (Kth > l) {
            if (longArr[Kth - s - 1] >= shortArr[s - 1]) {
                return longArr[Kth - s - 1];
            }
            if (shortArr[Kth - l - 1] >= longArr[l - 1]) {
                return shortArr[Kth - l - 1];
            }
            return getUpMedian(shortArr, 0, Kth - l, longArr, Kth - s, l - 1);
        }
        if (Kth > s && Kth < l) {
            if (longArr[Kth - s - 1] >= shortArr[s - 1]) {
                return longArr[Kth - s - 1];
            }

        }
        return getUpMedian(shortArr, 0, s-1, longArr, Kth - s, Kth-1);
    }
}
