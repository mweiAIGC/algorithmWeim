package class14;

public class Code05_DistinctSubsequences {
    /**
     * 给定两个字符串S和T，返回S字符串等于T的不同子序列个数有多少个？如果得到子序列A删除的位置与得到子序列B删除的位置不同，
     * 那么认为A和B就是不同的。
     * eg：
     * S="rabbbit",T="rabbit",
     * return:3
     * 因为可以删除rabbbit中3个不同b的位置，所以这三个子序列是不一样的。
     */
    public static int process(String S, String T) {
        char[] s = S.toCharArray();
        char[] t = T.toCharArray();
        int[][] dp = new int[s.length+1][t.length+1];
        for (int row = 0; row <= s.length; row++) {
            dp[row][0] = 1;
        }
        for (int col = 0; col <= t.length; col++) {
            dp[0][col] = 0;
        }
        for (int row = 1; row <= s.length; row++) {
            for (int col = 1; col <= t.length; col++) {
                // ① 如果不选S上的第i个字符，那么dp[row][col] =  dp[row-1][col];
                // ② 如果S上的第i个字符== T上的第j个字符，那么dp[row][col] += s[row] == t[col] ? dp[row - 1][col - 1] : 0
                dp[row][col] = dp[row - 1][col] + (s[row] == t[col] ? dp[row - 1][col - 1] : 0);
            }
        }
        return dp[s.length - 1][t.length - 1];
    }
}
