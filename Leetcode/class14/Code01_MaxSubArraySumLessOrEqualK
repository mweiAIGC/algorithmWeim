package class14;

import java.util.TreeSet;

public class Code01_MaxSubArraySumLessOrEqualK {
    /**
     * 给定一个数组arr，再给定一个k值，返回累加和小于等于k，但是离k最近的子数组累加和。
     * 算法思路，通过TreeSet来记录数组每个位置的前缀和
     * 1.我们要求所有满足sum[i]-sum[j]<=k的子数组和，并找到其中的最大值，
     * 2.不等式可转化为sum[j]>=sum[i]-k。对于每一个i，我们需要在所有j<i对应的前缀和sum[j]中，找到一个大于或等于sum[i]-k的最小值（即最早出现的位置）
     */
    public static int getLMaxLessOrEqualK(int[] arr, int k) {
        // 记录i之前的前缀和，按照有序表进行组织
        TreeSet<Integer> set = new TreeSet<>();
        // 一个数也没有的时候，已经有一个前缀和是0了
        set.add(0);

        int max = Integer.MIN_VALUE;
        int sum = 0;
        // 每一步i，都要求子数组必须已i结尾的情况下，求子数组的累加和，是<=k，并且是最大的
        for (int i = 0; i < arr.length; i++) {
            sum += arr[i];
            if (set.ceiling(sum - k) != null) {
                // ceiling(E e)会返回集合中大于或等于给定元素e的最小元素
                max = Math.max(max, sum - set.ceiling(sum - k));

            }
            set.add(arr[i]); //当前的前缀和加入到set中
        }
        return max;
    }
}
