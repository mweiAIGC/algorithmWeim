package class14;

public class Code03_LongestIncreasingPath {
    /**
     * 给定一个二维数组matrix，可以从任何位置出发，每一步可以走向上下左右四个方向。返回最大递增链的长度。
     * eg:
     * matrix=
     * 5 4 3
     * 3 1 2
     * 2 1 3
     * 从最中心的1出发，是可以走出1 2 3 4 5 的链的，而且这是最长的递增链。所以返回长度为5
     * 算法思路：求往上下左右的最大值max+1
     */
    public static int maxPath(int[][] matrix){
        int ans = Integer.MIN_VALUE;
        int[][] dp = new int[matrix.length][matrix[0].length];
        for(int row = 0; row<matrix.length;row++){
            for(int col = 0; col<matrix[0].length; col++){
                ans = Math.max(ans,process(matrix,row,col,dp));
            }
        }
        return ans;
    }

    private static int process(int[][] matrix, int row, int col, int[][] dp) {
        if(row<0 || row>=matrix.length || col<0 || col>=matrix[0].length) return -1;
        if(dp[row][col] != 0) return dp[row][col];
        int up = 0;
        int down = 0;
        int left = 0;
        int right = 0;
        if(row-1!=-1 && matrix[row-1][col] > matrix[row][col]){
            up = process(matrix,row-1,col,dp);
        }
        if(row+1 < matrix.length && matrix[row+1][col] > matrix[row][col]){
            down = process(matrix,row+1,col,dp);
        }
        if(col-1 !=-1 && matrix[row][col-1] > matrix[row][col]){
            left = process(matrix,row,col-1,dp);
        }
        if(col + 1 < matrix[0].length && matrix[row][col+1] > matrix[row][col]){
            right = process(matrix,row,col+1,dp);
        }
        dp[row][col] = 1 + Math.max(Math.max(up,down),Math.max(left,right));
        return dp[row][col];
    }
}
