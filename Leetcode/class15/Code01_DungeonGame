package class15;

public class Code01_DungeonGame {
    /**
     * 给定一个二维数组map,含义是一张地图，例如，如下矩阵：
     * -2 -3 3
     * -5 -10 1
     * 0 30 -5
     * 游戏规则如下：
     * 骑士从左上角出发，每次只能向右或向下走，最后到达右下角见到公主。
     * 地图中每个位置的值代表骑士要遭遇的事情。
     * 如果是负数，说明此处有怪兽，会损失血量。
     * 如果是非负数，说明此处有血瓶，能让骑士回血。
     * 骑士从左上角到右下角的过程中，走到任何一个位置时，血量都不能小于1.
     * 为了骑士能见到公主，初始血量至少时多少？根据map，返回至少的初始血量。
     */
    public static int knightProblem(int[][] matrix) {

        return process(matrix, 0, 0);
    }

    public static int process(int[][] matrix, int row, int col) {
        int N = matrix.length;
        int M = matrix[0].length;
        if (row == N - 1 && col == M - 1) return matrix[row][col] < 0 ? -matrix[row][col] + 1 : 1;
        if (row == N - 1) {
            int rightStep = process(matrix, row, col + 1);
            if (matrix[row][col] < 0){
                return -matrix[row][col]+1;
            }else if(matrix[row][col] >= rightStep){
                return 1;
            }else {
                return rightStep - matrix[row][col];
            }
        }
        if(col == M -1){
            int downStep = process(matrix, row+1,col);
            if(matrix[row][col] < 0){
                return -matrix[row][col] + 1;
            }else if(matrix[row][col] >= downStep){
                return 1;
            }else {
                return downStep-matrix[row][col];
            }
        }
        int minStep = Math.min(process(matrix,row,col+1),process(matrix, row+1, col));
        if(matrix[row][col] < 0){
            return -matrix[row][col] + 1;
        }else if(matrix[row][col] >= minStep){
            return 1;
        }else {
            return minStep - matrix[row][col];
        }
    }

}
