package class19;
import java.util.LinkedList;
public class Code03_ExpressionCompute {
    /**
     * 给定一个字符串str,str表示一个公式，公式里可能有整数、加减乘除符号和左右括号，返回公式的计算结果。
     * eg:
     * str="48*((76-65)-43)+8*1"
     * str="3+1*4,返回7"
     * str="3+(1*4)，返回7"
     * 说明：1.可以认为给定的字符串一定是正确的公式，即不需要对str做公式有效性检查。2.如果是负数，
     * 就需要用括号括起来，比如"4*(-3)"。但如果负数作为公式的开头或括号部分的开头，则可以没有括号，比如"-3*4"和"(-3*4)"
     * 都是合法的。3.不用考虑计算过程中会发生溢出的情况。
     * <p>
     * 算法思路：
     * 1) 从str[i..]往下算，遇到字符串终止位置或者右括号，就停止；
     * return: 负责的这一段的结果{res},负责的这一段计算的位置{index}
     */
    public static int getValue(String str) {

        return value(str.toCharArray(), 0)[0];
    }

    public static int[] value(char[] str, int index){
        LinkedList<String> queue = new LinkedList<>();
        int cur = 0;
        int[] res = null;
        while(str[index]!=')' && index < str.length){
            if(str[index]>='0'&&str[index]<='9'){
                cur = cur*10 + str[index] - '0';
            }else if(str[index] != '('){ // 如果该字符!='C',那么就是"+||-||*||/"
                CalculateValue(queue, cur);
                queue.addLast(String.valueOf(str[index]));
                cur = 0;
            }else {
                res = value(str, index+1);
                cur = res[0];
                index = res[1]+1;
            }

        }
        CalculateValue(queue,cur);
        return new int[]{getLastValue(queue),index};

    }

    public static void CalculateValue(LinkedList<String> queue, int value){
        if(!queue.isEmpty()){
            int cur = 0;
            String top = queue.pollLast();
            if(top.equals("+") || top.equals("-")){
                queue.addLast(top);
            }else{
                cur = Integer.valueOf(queue.pollLast());
                value = top.equals("/")? (cur/value) : (cur * value);
            }
        }
        queue.addLast(String.valueOf(value));
    }

    public static int getLastValue(LinkedList<String> queue){
        int ans = 0;
        boolean isAdd = true;

        while(!queue.isEmpty()){
            String cur = queue.pollFirst();
            if(cur.equals("+")){
                isAdd = true;
            }else if(cur.equals("-")){
                isAdd = false;
            }else {
                ans+=isAdd?Integer.valueOf(cur):-Integer.valueOf(cur);
            }
        }
        return ans;
    }

}
