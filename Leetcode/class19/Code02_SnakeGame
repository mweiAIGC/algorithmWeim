package class19;

public class Code02_SnakeGame {
    /**
     * 给定一个二维数组matrix，每个单元都是一个整数，有正有负。最开始一条长度为0的蛇，从矩阵
     * 最左侧任选一个单元格进入地图，蛇每次只能够到达当前位置的右上相邻，右侧相邻和右下相邻的单元格。
     * 蛇到达一个单元格后，自身的长度会瞬间加上该单元格的数值，任何情况下长度为负则游戏结束。
     * 小蛇是个天才，它拥有一个超能力，可以在游戏开始的时候把地图中的某个节点的值变为其相反数(最多只能改变一个节点)。
     * 问小蛇在游戏过程中，他的最长长度可以是多少？
     * eg:
     * 1 -4 10
     * 3 -2 -1
     * 0 5 -2
     * 最优路径为从左侧的3开始，3 ——> -4(用能力变为4) ——>10/所以返回17
     *
     * 算法思路：(如果到达某一个位置累计和为负，小蛇死亡)
     * 从假想的最优左侧到达(i,j)的旅途中，即我们从(i,j)——>(i',0)
     * 1) 使用能力的情况下，返回路径的最大和，没有可能到达的话，返回负(无效解)
     * 2) 不使用能力的情况下，返回路径的最大和，没有可能到达的话，返回负
     */
    public static int walk1(int[][] matrix){
        if(matrix.length == 0 || matrix[0].length == 0) return 0;
        int N = matrix.length;
        int M = matrix[0].length;
        int res = Integer.MIN_VALUE;
        for(int i = 0; i < N; i++){
            for(int j = 0; j < M; j++){
                int[] ans = process(matrix,i,j);
                res = Math.max(res,Math.max(ans[0],ans[1]));
            }
        }
        return res;

    }

    public static int[] process(int[][] matrix, int i, int j){
        if(j == 0) return new int[]{matrix[i][i], -matrix[i][j]};
        int[] res = process(matrix,i,j-1);
        int preUnused = res[0];
        int preUsed = res[1];
        if(i-1 >=0){
            res = process(matrix,i-1,j-1);
            preUnused = Math.max(preUnused,res[0]);
            preUsed = Math.max(preUsed,res[1]);
        }
        if(i+1 < matrix.length){
            res = process(matrix,i+1,j-1);
            preUnused = Math.max(preUnused,res[0]);
            preUsed = Math.max(preUsed,res[1]);
        }
        int NoUsed = -1; // 之前没使用过能力，在当前位置也不使用能力的最优解
        int Used = 1; // 之前使用过能力，在当前位置的最优解
        if(preUnused > 0){
            NoUsed = matrix[i][j] + preUnused;
            Used = -matrix[i][j] + preUnused;
        }
        if(preUsed > 0){
            Used = Math.max(matrix[i][j] + preUsed,Used);
        }
        return new int[]{NoUsed, Used};
    }

}
