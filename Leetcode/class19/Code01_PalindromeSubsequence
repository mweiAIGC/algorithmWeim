package class19;

public class Code01_PalindromeSubsequence {
    /**
     * 给定一个字符串str，求最长回文子序列长度
     */
    public static int ways(String s) {
        if (s.length() == 0 || s == null) return 0;
        int N = s.length();
        char[] c = s.toCharArray();
        int[][] dp = new int[N][N];
        for (int i = 0; i < c.length; i++) {
            dp[i][i] = 1;
        }
        for (int i = 0; i < N - 1; i++) {
            dp[i][i + 1] = c[i] == c[i + 1] ? 2 : 1;
        }
        for (int i = N - 3; i >= 0; i--) {
            for (int j = i + 2; j < N; j++) {
                dp[i][j] = Math.max(dp[i + 1][j], dp[i][j - 1]);
                if (c[i] == c[j]) dp[i][j] = Math.max(dp[i][j], dp[i + 1][j - 1] + 2);
            }

        }
        return dp[0][N - 1];
    }


    // 方法二，采用reversed String。字符相等就＋1，求最大的公共子串
    public static int ways2(String str) {
        if (str.length() == 0 || str == null) return 0;
        int N = str.length();
        char[] ch = str.toCharArray();
        char[] reversed = new char[N];
        for (int i = 0; i < N; i++) {
            reversed[i] = ch[N - 1 - i];
        }
        int[][] dp = new int[N][N];
        dp[0][0] = ch[0] == reversed[0] ? 1 : 0;
        for (int i = 1; i < N; i++) {
            dp[i][0] = Math.max(dp[i - 1][0], ch[i] == reversed[0] ? 1 : 0);
            dp[0][i] = Math.max(dp[0][i], ch[0] == reversed[0] ? 1 : 0);
        }
        for(int i = 1; i < N; i++){
            for(int j = 1; j < N; j++){
                dp[i][j] = Math.max(dp[i-1][j],dp[i][j-1]);
                if(ch[i] == reversed[j]){
                    dp[i][j] = Math.max(dp[i][j],dp[i-1][j-1]+1);
                }
            }
        }
        return dp[N-1][N-1];

    }


}
