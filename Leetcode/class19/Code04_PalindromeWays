package class19;

public class Code04_PalindromeWays {
    /**
     * 对于一个字符出啊，从前开始读和从后开始读是一样的，我们就称这个字符串是回文串。牛牛特别喜欢回文串，他手中有一个
     * 字符串s，牛牛子啊思考能否从字符中溢出部分(0个或多个)字符串使其变成回文串，并且牛牛认为空串不是回文串。
     * 牛牛发现移除的方案可能有很多种，希望你帮他计算一下一共有多少种移除方案可以使得s变为回文串。对于两种给移除方案，
     * 如果移除的字符依次构成的序列不一样，就是不同的方案。
     *
     * 算法思路:
     * 定义回文串arr[L] && arr[R]
     * 一共有4中情况：
     * arr[L+1] ... arr[R-1] 有a中方案   动态数组中dp[L+1][R] = a + b
     * arr[L+1] ... arr[R]  有b中方案    动态数组中dp[L][R-1] = a + c
     * arr[L] ... arr[R-1] 有c中方案     方案 a = dp[L+1][R-1]
     * arr[L] ... arr[R] 该情况 if arr[L] == arr[R] then dp[L][R] = dp[L+1][R-1] + 1 (因为包括dp[L+1][R-1]是空串的情况)
     */

    public static int palindromeWays(String s) {
        if(s == null || s.length() == 0) return 0;
        char[] chars = s.toCharArray();
        int N = chars.length;
        int[][] dp = new int[N][N];
        for(int i = 0; i<N; i++){
            dp[i][i] = 1;
        }
        for(int i = 0; i < N-1; i++){
            dp[i][i+1] = chars[i] == chars[i+1] ? 3:2;
        }
        for(int i = N-3; i >= 0; i--){
            for(int j = i + 2; j < N;j++){
                dp[i][j] = dp[i+1][j] + dp[i][j-1] - dp[i+1][j-1];
                if(chars[i] == chars[j]){
                    dp[i][j] += dp[i+1][j-1] + 1;
                }

            }
        }
        return dp[0][N-1];
    }
}
